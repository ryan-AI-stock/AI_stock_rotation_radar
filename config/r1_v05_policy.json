{
  "version": "r1-v0.6-free-data-long-hold-advisor-research",
  "status": "challenger_report_only",
  "portfolio_start_date": "2026-08-05",
  "cadence": {
    "daily": ["official_close", "actual_portfolio_nav", "two_benchmark_navs", "recommendation_rank"],
    "weekly": ["target_price_consensus", "theme_momentum", "catalyst_and_risk_review"],
    "quarterly": ["theme_bottleneck_review", "theme_membership_review", "theme_top3_review"]
  },
  "ranking_weights": {
    "structural_bottleneck": 0.25,
    "revenue_earnings_realization": 0.25,
    "theme_momentum_and_catalyst": 0.15,
    "relative_valuation": 0.15,
    "price_chip_risk": 0.20
  },
  "ranking_component_methods": {
    "structural_bottleneck": "既有bottleneck_score，須有可追溯瓶頸證據",
    "revenue_earnings_realization": "最新PIT官方月營收年增率之正式池百分位50%＋最新PIT官方財務品質50%",
    "theme_momentum_and_catalyst": "既有catalyst_score",
    "relative_valuation": "既有valuation_score",
    "price_chip_risk": "免費資料三構面：價格過熱安全50%、法人籌碼33.33%、融資結構16.67%；三項缺一即NA；4W／12W僅作信心確認"
  },
  "target_price_overlay": {
    "core_weight": 0.0,
    "consensus_target_upside_weight": 0.6666666667,
    "target_revision_and_breadth_weight": 0.3333333333,
    "purpose": "獨立信心加減項；缺值不阻斷免費資料核心排名"
  },
  "target_price_policy": {
    "horizon": "12M",
    "minimum_independent_institutions": 3,
    "maximum_age_calendar_days": 90,
    "aggregation": "median",
    "single_broker_is_scoreable": false,
    "winsorized_upside_floor": -0.20,
    "winsorized_upside_cap": 0.80
  },
  "recommendation_priority": {
    "P1": "可執行優先換倉；資料完整且候選優勢明顯",
    "P2": "分批換倉；優勢存在但仍需觀察成交與盤勢",
    "P3": "觀察；不建議立即成交",
    "NO_ACTION": "沒有足夠優勢或資料不足"
  },
  "long_hold_rotation_guardrails": {
    "minimum_core_score_advantage": 10.0,
    "incumbent_weak_threshold": 40.0,
    "challenger_healthy_threshold": 50.0,
    "incumbent_must_be_weak_in": ["price_chip_risk", "theme_momentum_and_catalyst"],
    "challenger_must_be_healthy_in_all": ["price_chip_risk", "theme_momentum_and_catalyst"],
    "rule": "總分較高本身不構成換倉；持股先出現可觀察弱項，候選再以同口徑證明明顯優勢"
  },
  "execution_boundary": {
    "automatic_order": false,
    "actual_fill_required_to_update_holdings": true,
    "failed_or_partial_fill_does_not_assume_execution": true,
    "maximum_core_holdings": 5,
    "long_term_targets_unchanged": true
  },
  "missing_value_policy": "NA_BLOCKS_COMPONENT_NO_ZERO_NO_WEIGHT_REDISTRIBUTION"
}
